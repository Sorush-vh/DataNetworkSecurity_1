          "expected_patched": {
            "exit_code": 2,
            "stdout": ""
          },
          "role": "alternate"
        }
      }
    ]
  },
  "hardening": {
    "required": {
      "relro": "full",
      "pie": "enabled",
      "nx": "enabled",
      "stack_canary": "present"
    }
  },
  "scenarios": {
    "correct": {
      "patched_version": "correct",
      "expected_exit_code": 0,
      "expected_statuses": [
        "FIXED"
      ]
    },
    "incomplete": {
      "patched_version": "incomplete",
      "expected_exit_code": 10,
      "expected_statuses": [
