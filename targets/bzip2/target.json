        ],
        "expected": {
          "exit_code": 2,
          "stdout": ""
        },
        "reference": "targets/bzip2/reference-tests.json#INV-TRUNCATED"
      },
      {
        "id": "SEC-ORIGINAL",
        "category": "invalid",
        "input": {
          "mode": "file",
          "path": "inputs/selector-overflow.bz2",
          "name": "selector-overflow.bz2"
