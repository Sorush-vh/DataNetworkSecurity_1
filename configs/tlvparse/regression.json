      },
      "args": [
        "{input}"
      ],
      "expected": {
        "exit_code": 2,
        "stdout": ""
      },
      "reference": "targets/tlvparse/reference-tests.json#SEC-ALTERNATE",
      "classifier": {
        "kind": "security",
        "build_type": "asan_ubsan",
        "expected_patched": {
          "exit_code": 2,
          "stdout": ""
        },
        "role": "alternate"
      }
    }
  ]
}
